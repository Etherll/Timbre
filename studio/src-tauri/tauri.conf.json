{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timbre Studio",
  "version": "0.1.0",
  "identifier": "studio.timbre.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Timbre Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMERGQTJFMTI2MEVCRjUKUldUMTYyQVNMdm9OZ0NXQ1JHL1YxVk0rQ3FRMW1rajZLb0Y5eWQrSGgxSitXU3NFV0lleGhWUmgK",
      "endpoints": [
        "https://github.com/Etherll/Timbre/releases/latest/download/latest.json"
      ]
    }
  }
}
